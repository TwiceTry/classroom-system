{
  // ============================================================
  //  .bat 在中文 Windows 上必须是 GBK
  //
  //  cmd.exe 按控制台代码页（CP936）逐字节解析批处理文件，
  //  存成 UTF-8 会让脚本里的中文和中文路径全部失效
  //  （`set "PAGE=...中文目录\index.html"` 这种直接不成立）。
  //
  //  但 VS Code 默认按 UTF-8 打开，所以只对 .bat 单独指定 GBK：
  //  编辑器里能正常显示中文，保存时也不会被改写成 UTF-8。
  //
  //  仓库里其它文件（.js / .mjs / .vue / .md / .html / .css / .py / .json）
  //  一律保持 UTF-8，不要动。
  //
  //  若你的 VS Code 不认语言级覆盖：
  //  打开 .bat → 状态栏右下角编码 → Reopen with Encoding → 选 GBK。
  //
  //  现在还剩 .bat 的地方：教学机代理/（启动代理 / 打开教师端 /
  //  打开学生端 / run-selftest）
  // ============================================================
  "[bat]": {
    "files.encoding": "gbk",
    "files.autoGuessEncoding": true
  }
}
